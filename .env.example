# Copy to .env for local work. NEVER commit .env.
# No AI or API keys are needed: the site only shows the photos you upload.

# Who may upload/replace photos (anyone can VIEW). Optional locally.
# On a public server, set 12+ characters; without it, uploads are disabled there (read-only).
ADMIN_KEY=

# Frontend on another domain than the API: comma-separated exact origins, no trailing slash
CORS_ORIGINS=

PORT=8787

# Frontend (Vercel build setting). Leave empty locally (Vite proxies /api).
VITE_API_URL=
